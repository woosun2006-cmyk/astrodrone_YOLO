# Copy this file to simulation.env for machine-local overrides.
# Explicitly exported environment variables take precedence over this file.
ARDUPILOT_DIR=/home/hyojin/ardupilot
ARDUPILOT_GAZEBO_DIR=/home/hyojin/ardupilot_gazebo
ASTRODRONE_REPO=/mnt/c/Users/leems/OneDrive/Desktop/astrodrone_YOLO

# Keep Linux build products and SITL state outside the OneDrive repository.
SIM_BUILD_DIR=/tmp/astrodrone-control-sim-build
SIM_RUNTIME_DIR=/tmp/astrodrone-simulation-runtime

# The installed ardupilot_gazebo README provides this compatible pair.
SIM_WORLD=iris_runway.sdf
SIM_MODEL=iris_with_gimbal

# Separate project camera scenario. These do not change the upstream smoke pair.
CAMERA_SIM_WORLD=ensamb_iris_runway.sdf
CAMERA_SIM_MODEL=ensamb_with_gimbal
CAMERA_BODY_MODEL=ensamb_with_standoffs
CAMERA_LINK=down_camera_link
CAMERA_SENSOR=down_camera

SITL_FRAME=gazebo-iris
SITL_INSTANCE=0
SITL_LOCATION=
SITL_SPEEDUP=1
SITL_PARAM_FILE=
GAZEBO_HEADLESS=0
GZ_VERBOSITY=4

# MAVProxy discovery checks this override, PATH, then known ArduPilot venvs.
# Leave empty to auto-detect /home/hyojin/venv-ardupilot/bin/mavproxy.py.
MAVPROXY_BIN=
MAVPROXY_STREAMRATE=4
SMOKE_TELEMETRY_TIMEOUT=30
TELEMETRY_FRESHNESS_SEC=3

# The basic smoke test only enables the read-only output. These are optional.
ENABLE_CONTROL_OUTPUT=0
ENABLE_GCS_OUTPUT=0

# All simulation traffic is loopback-only. Do not put serial device paths here.
GAZEBO_FDM_PORT=9002
SITL_MASTER_TCP_PORT=5760
CONTROL_UDP_PORT=14550
TELEMETRY_UDP_PORT=14551
GCS_UDP_PORT=14552

# Optional transparent packet-audit relay used during validation.
MAVPROXY_MASTER_ENDPOINT=tcp:127.0.0.1:5760
MAVLINK_AUDIT_TCP_PORT=5770
MAVLINK_AUDIT_REPORT=/tmp/astrodrone-mavlink-audit.json
