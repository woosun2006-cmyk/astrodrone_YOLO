#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/project-env.sh"

command -v cmake >/dev/null 2>&1 || {
  printf '%s\n' '[telemetry-bench-cpp] cmake is required.' >&2
  exit 1
}

mkdir -p -- "$BUILD_DIR"
if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ||
      "$CONTROL_DIR/CMakeLists.txt" -nt "$BUILD_DIR/CMakeCache.txt" ]]; then
  cmake_version="$(cmake --version | sed -n '1s/.*version //p')"
  cmake_major="${cmake_version%%.*}"
  cmake_minor="${cmake_version#*.}"
  cmake_minor="${cmake_minor%%.*}"
  if (( cmake_major > 3 || (cmake_major == 3 && cmake_minor >= 13) )); then
    cmake -S "$CONTROL_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=RelWithDebInfo
  else
    (cd "$BUILD_DIR" && cmake "$CONTROL_DIR" -DCMAKE_BUILD_TYPE=RelWithDebInfo)
  fi
fi

build_jobs="${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
if cmake --help 2>/dev/null | grep -q -- '--build <dir>'; then
  cmake --build "$BUILD_DIR" --target telemetry_bench -- -j"$build_jobs"
else
  make -C "$BUILD_DIR" -j"$build_jobs" telemetry_bench
fi

if [[ "${1:-}" == '--build-only' ]]; then
  exit 0
fi

exec "$BUILD_DIR/telemetry_bench" "$@"
