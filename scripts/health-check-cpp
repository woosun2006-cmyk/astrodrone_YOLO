#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
source "$SCRIPT_DIR/project-env.sh"

command -v cmake >/dev/null 2>&1 || {
  printf '%s\n' '[health-check-cpp] cmake is required.' >&2
  exit 1
}

mkdir -p -- "$BUILD_DIR"
if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ]]; then
  cmake -S "$CONTROL_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=RelWithDebInfo
fi
cmake --build "$BUILD_DIR" --target health_check -j"${CMAKE_BUILD_PARALLEL_LEVEL:-2}"

if [[ "${1:-}" == '--build-only' ]]; then
  exit 0
fi

exec "$BUILD_DIR/health_check" "$@"
