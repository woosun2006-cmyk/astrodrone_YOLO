real:
  serial:
    address: /dev/ttyACM1
    baud: 115200
  proxy_udp:
    address: udp:127.0.0.1:14550

sitl:
  local_tcp:
    address: tcp:127.0.0.1:5762
  remote_udp:
    address: udp:0.0.0.0:14561
    note: Mission Planner SITL 에서 젯슨(192.168.0.196:14561)으로 MAVLink UDP 출력 추가

heartbeat_timeout: 20

# Target-approach guidance: target_distance.cpp computes a range to the
# YOLO-detected target and publishes it over loopback UDP; control.cpp
# consumes it and flies toward the target. See target_distance.cpp and
# control.cpp for how each value is used.
target_track:
  yolo_host: 127.0.0.1
  yolo_port: 8002          # must match setting/cam_sets.yaml's yolo_live port
  udp_port: 15020          # loopback link: target_distance.cpp -> control.cpp
  # Pinhole-camera model (control/pos_calculator.cpp): ground_offset_m =
  # pixel_offset / pixel_focal_length_px * altitude_m. Replaces the old flat
  # pixel_to_meter multiplier, which gave the same real-world distance for a
  # given pixel offset no matter the altitude - wrong, since the same pixel
  # offset covers more ground the higher up the camera is. 530 is a rough
  # starting value, not derived from a measured focal length/FOV - calibrate
  # against a real target at a known distance/altitude before trusting the
  # computed range for actual flight.
  pixel_focal_length_px: 530
  target_stale_ms: 400     # ignore a YOLO detection older than this
  altitude_stale_ms: 500   # target_distance.cpp stops asserting altitude_valid past this
  # Outlier guard on the computed distance_m (target_distance.cpp) - both
  # placeholders, tune against this vehicle's real operating range.
  max_plausible_distance_m: 50.0  # reject any single reading beyond this
  max_distance_jump_m: 5.0        # reject a reading that jumps this far from the last accepted one
  link_stale_ms: 500       # control.cpp hovers if no UDP packet this recent
  max_forward_speed: 0.5   # m/s cap, control.cpp's approach velocity
  # Yaw-first guidance: control.cpp turns the vehicle to face the target
  # (yaw_rate, capped at max_yaw_rate) instead of crab-walking sideways,
  # and only opens up forward speed once roughly aligned - see
  # control.cpp's approach_target() for the alignment taper.
  max_yaw_rate: 0.6         # rad/s cap on the yaw-alignment turn rate
  yaw_align_px: 80.0        # forward speed ramps in as |x_px offset| falls within this
  stop_distance: 2.0       # m; forward speed -> 0 once inside this range
  target_lost_land_sec: 10.0  # control.cpp lands if the target stays lost this long
  approach_duration_sec: 60  # control.cpp lands automatically after this long
  # control --auto-intercept only (run_auto_intercept() in control.cpp): the
  # vehicle is expected to already be flying its own AUTO mission, and this
  # only takes over into GUIDED once a target locks on - see control.cpp's
  # top-of-function comment on run_auto_intercept() for the full flow.
  lock_confirm_sec: 1.0             # target must track continuously this long before taking over from AUTO
  intercept_approach_duration_sec: 30  # cap on one GUIDED approach attempt before handing back to AUTO
  reacquire_cooldown_sec: 3.0       # pause after handing back to AUTO before watching for the next lock
  # control.cpp's 1.range calc -> 2.velocity calc -> 3.send-to-Pixhawk cycle
  # period. Deliberately kept faster than target_distance.cpp's own sensing
  # rate (setting/rate.yaml's sense_cycle_ms): ArduPilot's GUIDED mode wants
  # a steady velocity setpoint stream, and control.cpp already re-sends the
  # last valid target reading between fresh ones (see target_stale_ms/
  # link_stale_ms above), so this can run faster than the sensing side
  # without needing fresher data every tick.
  control_cycle_ms: 50
