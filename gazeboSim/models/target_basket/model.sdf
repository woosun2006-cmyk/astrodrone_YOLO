<?xml version="1.0" ?>
<!--
  Copy of simulation/models/target_basket with one deliberate change: the
  material is red instead of white.

  gazeboSim/gazebo_camera_target.py finds the target by HSV colour threshold,
  and the original white basket (ambient/diffuse 1 1 1 1) is indistinguishable
  from the runway and the sky in the simulated camera feed. Red sits well
  outside anything else in the iris_runway world, which keeps the harness
  testing the *pipeline* rather than the detector's ability to segment white
  on grey.

  Geometry, collision box and mesh are unchanged, so the pixel-offset ->
  ground-offset maths in control/target_distance.cpp sees the same target size
  as the simulation/ asset it came from. simulation/ itself is not modified.
-->
<sdf version="1.9">
  <model name="target_basket">
    <static>true</static>
    <link name="basket_link">
      <pose>0 0 0 0 0 0</pose>

      <collision name="basket_collision">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.238 0.138 0.070</size>
          </box>
        </geometry>
      </collision>

      <visual name="basket_visual">
        <pose>-0.110 -0.060 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://target_basket/meshes/basket.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.8 0.05 0.05 1</ambient>
          <diffuse>0.9 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
