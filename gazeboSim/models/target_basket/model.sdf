<?xml version="1.0" ?>
<!--
  YOLO simulation target matched to the real training target: an off-white,
  perforated plastic basket.  The collision box retains the real dimensions.

  The detector-facing visual uses a tightly cropped real reference appearance
  from the training set.  At the 4 m diagnostic altitude its 1.033 x 0.690 m
  plane reproduces the same ~111 x 69 px basket footprint that the model saw
  in high-confidence training tiles when rendered by the 1920 x 1080 camera.
  It is deliberately a visual proxy, not the physical basket scale.

  Collision stays at the real basket dimensions (~0.238 x 0.138 x 0.070 m),
  so the enlarged rendering cannot trap or block the simulated aircraft.
-->
<sdf version="1.9">
  <model name="target_basket">
    <static>true</static>
    <link name="basket_link">
      <pose>0 0 0 0 0 0</pose>

      <collision name="basket_collision">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.238 0.138 0.070</size>
          </box>
        </geometry>
      </collision>

      <visual name="basket_detector_visual">
        <pose>0 0 0.004 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.033 0.690</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/white_basket_reference_crop.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
