#!/usr/bin/env python3
"""Stream every detected CSI camera as MJPEG with live fps/resolution readou>

Standard library only. A HUD in the top-right corner of each stream shows the
measured fps, resolution, frame size and bandwidth.
"""
import http.server
import json
import re
import socket
import socketserver
import subprocess
import threading
import time
from collections import deque

PORT = 8000
WIDTH, HEIGHT, FPS = 1456, 1088, 60

cameras = {}  # index -> dict
stopping = threading.Event()


def discover():
    """Parse camera index and sensor name from rpicam-hello --list-cameras."""
    try:
        out = subprocess.run(
            ["rpicam-hello", "--list-cameras"],
            capture_output=True, text=True, timeout=20,
        ).stdout
    except Exception:
        return {}
    return {
        int(m.group(1)): m.group(2)
        for m in (re.match(r"\s*(\d+)\s*:\s*(\S+)", ln) for ln in out.splitl>
        if m
    }

def cleanup():
    stopping.set()
    for cam in cameras.values():
        proc = cam.get("proc")
        if proc and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()


if __name__ == "__main__":
    for idx, name in discover().items():
        cameras[idx] = {
            "name": name,
            "frame": None,
            "cond": threading.Condition(),
            "times": deque(maxlen=60),
            "sizes": deque(maxlen=60),
            "count": 0,
            "proc": None,
        }
        threading.Thread(target=grabber, args=(idx,), daemon=True).start()
    banner()
    httpd = Server(("0.0.0.0", PORT), Handler)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopping...", flush=True)
    finally:
        # Never call httpd.shutdown() from this thread: serve_forever() runs
        # here, so it would deadlock. server_close() is the safe teardown.
        cleanup()
        httpd.server_close()
        print("camera released. bye.", flush=True)
